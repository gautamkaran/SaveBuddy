---
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment -%}
    Only real HTML pages belong in the sitemap. `site.pages` also contains
    generated assets (CSS, JS, search-data.json), robots.txt and this file,
    which must never be advertised to crawlers.
  {%- endcomment -%}
  {%- for page in site.pages -%}
  {%- assign is_html = false -%}
  {%- assign page_ext = page.name | split: "." | last -%}
  {%- if page_ext == "md" or page_ext == "html" -%}
  {%- assign is_html = true -%}
  {%- endif -%}
  {%- if page.sitemap != false and is_html -%}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    {%- assign lastmod = page.last_modified_at | default: page.date -%}
    {%- if lastmod %}
    <lastmod>{{ lastmod | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
  {%- endif -%}
  {%- endfor -%}
  {%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- endfor %}
</urlset>
